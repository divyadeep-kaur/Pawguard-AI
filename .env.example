# Optional. Without a key the scanner and chat run in clearly-labelled demo mode.
GEMINI_API_KEY=""
# Accounts portal (Supabase). Set these in Vercel -> Project -> Settings -> Environment Variables
# (Production + Preview), then redeploy. scripts/build-config.mjs writes them into public/config.js.
# Use the ANON / publishable key ONLY. The build fails if it detects a service_role / secret key.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Optional. Port for the web server (default 3000)
PORT=3000
