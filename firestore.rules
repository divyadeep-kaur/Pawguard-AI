rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRescueReport(data) {
      return data.keys().hasAll(['ticketNumber', 'animalType', 'description', 'location', 'reporterName', 'reporterContact', 'status', 'timestamp'])
        && data.ticketNumber is string && data.ticketNumber.size() <= 128
        && data.animalType is string && data.animalType.size() <= 100
        && data.description is string && data.description.size() <= 2000
        && data.location is string && data.location.size() <= 500
        && data.reporterName is string && data.reporterName.size() <= 200
        && data.reporterContact is string && data.reporterContact.size() <= 100
        && data.status in ['Reported', 'Dispatched', 'In-Rescue', 'Recovered'];
    }

    match /rescueReports/{ticketNumber} {
      allow read, list: if true;
      allow create: if isValidId(ticketNumber) && isValidRescueReport(incoming());
      allow update: if isValidId(ticketNumber) && isValidRescueReport(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAll(['status']) ||
        incoming().diff(existing()).affectedKeys().hasAny(['status', 'breed', 'healthStatus'])
      );
      allow delete: if false;
    }

    function isValidAdoptionRequest(data) {
      return data.keys().hasAll(['id', 'animalId', 'animalName', 'applicantName', 'applicantEmail', 'applicantPhone', 'visitDate', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.animalId is string && data.animalId.size() <= 128
        && data.animalName is string && data.animalName.size() <= 100
        && data.applicantName is string && data.applicantName.size() <= 200
        && data.applicantEmail is string && data.applicantEmail.size() <= 200
        && data.applicantPhone is string && data.applicantPhone.size() <= 100
        && data.visitDate is string && data.visitDate.size() <= 50
        && data.status in ['Pending', 'Approved', 'Contacted'];
    }

    match /adoptionRequests/{requestId} {
      allow read, list: if true;
      allow create: if isValidId(requestId) && isValidAdoptionRequest(incoming());
      allow update: if isValidId(requestId) && isValidAdoptionRequest(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAll(['status'])
      );
      allow delete: if false;
    }
  }
}
